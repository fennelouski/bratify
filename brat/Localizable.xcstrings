        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фильтр көрінісін тазартады және фонның масштабын, аудармасын, бұлдырлығын және мөлдірлігін қалпына келтіреді"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터 모양을 지우고 배경 확대/축소, 뒤집기, 흐림 및 투명도를 재설정합니다"
