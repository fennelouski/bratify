    "LatchOrTouchHelp": {
      "comment": "Explain what happens when the user touches the button/toggle that switches between \"latch\" mode and \"tap\" mode",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies tussen Vergrendelmodus (tik om te wissel) of Raakmodus (druk aan, laat los)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر بين وضع الإقفال (اضغط للتبديل) أو وضع اللمس (اضغط للتشغيل، ارفع يدك للإيقاف)."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце паміж рэжымам зашчапкі (націсніце, каб пераключыць) або рэжымам дотыку (націсніце, адпусціце выключана)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете между режим на заключване (докоснете, за да превключите) или режим на докосване (натиснете включено, освободете изключено)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ল্যাচ মোড (টগল করতে আলতো চাপুন) বা টাচ মোড (চালু করুন, ছেড়ে দিন) এর মধ্যে বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria entre el mode Latch (toca per alternar) o el mode Touch (mantén per activar, deixa anar per apagar)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte režim Latch (klepnutím zap./vyp.) nebo Touch (držením zap., uvolněním vyp.)."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dewiswch rhwng modd Latch (tapiwch i doglo) neu'r modd Cyffwrdd (pwyswch ymlaen, rhyddhau i ffwrdd)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg mellem Latch (tryk for at skifte) eller Touch (hold for at tænde, slip for at slukke)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zwischen „Latch“ (Tippen zum Umschalten) oder „Touch“ (Gedrückt halten für An, loslassen für Aus)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε μεταξύ λειτουργίας Latch (πάτημα για εναλλαγή) ή Touch (κράτημα για ενεργοποίηση, άφησμα για απενεργοποίηση)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose between Latch mode (tap to toggle) or Touch mode (press on, release off)."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose between Latch mode (tap to toggle) or Touch mode (press on, release off)."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose between Latch mode (tap to toggle) or Touch mode (press on, release off)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose between Latch mode (tap to toggle) or Touch mode (press on, release off)."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose between Latch mode (tap to toggle) or Touch mode (press on, release off)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige entre el modo Fijar (toque para activar/desactivar) o el modo Tocar (mantener y soltar)"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige entre modo Latch (toca para alternar) o Touch (mantén para encender, suelta para apagar)."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige entre modo Latch (toca para alternar) o Touch (mantén para encender, suelta para apagar)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valige lukustusrežiimi (lülitamiseks puudutage) või puuterežiimi (vajutage sisse, vabastage välja) vahel."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aukeratu Latch modua (sakatu txandakatzeko) edo Ukipen modua (sakatu, askatu desaktibatu)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بین حالت قفل (برای جابجایی ضربه بزنید) یا حالت لمس (روشن فشار دهید، رها کنید) را انتخاب کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse Latch (napauta vaihtaaksesi) tai Touch (paina päälle, päästä irti pois)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili sa pagitan ng Latch mode (i-tap para i-toggle) o Touch mode (pindutin ang on, release off)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir entre le mode Verrouillage (appuyer pour basculer) ou le mode Toucher (appuyer et relâcher)"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis entre le mode Latch (appuyer pour basculer) ou Touch (maintenir pour activer, relâcher pour désactiver)."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh idir mód Latch (tapáil chun scoránaigh) nó modh Tadhaill (brúigh ar aghaidh, scaoil amach)."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolle entre o modo Latch (toca para alternar) ou o modo Touch (preme, solta para apagar)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר בין מצב Latch (הקש כדי לשנות) או Touch (לחץ להפעלה, שחרר לכיבוי)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Latch मोड (टॉगल के लिए टैप) या Touch मोड (दबाकर चालू, छोड़कर बंद) चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi između Latch (dodir za prebacivanje) ili Touch (drži za uključi, otpusti za isključi)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz a „Latch” (érintés a be-/kikapcsoláshoz) és a „Touch” (nyomva tartás bekapcsol, felengedés kikapcsol) módok között."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք սողնակ ռեժիմի միջև (հպեք՝ փոխարկելու համար) կամ Հպման ռեժիմի միջև (սեղմեք միացնել, անջատել):"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih antara mode Latch (ketuk untuk mengaktifkan/nonaktifkan) atau mode Touch (tekan untuk menyalakan, lepas untuk mematikan)."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu á milli Latch mode (smelltu til að skipta) eða Touch mode (ýttu á, slepptu af)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli tra modalità Latch (tocca per attivare/disattivare) o modalità Touch (premi per accendere, rilascia per spegnere)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラッチモード（タップでオン/オフ切り替え）かタッチモード（押すとオン、離すとオフ）を選択します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ ჩამკეტის რეჟიმს (შეეხეთ გადასართავად) ან შეხების რეჟიმს (დააჭირეთ ჩართეთ, გამორთეთ)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бекіту режимі (қосу үшін түртіңіз) немесе түрту режимі (қосу, өшіру) арасында таңдаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "래치 모드(한 번 탭하여 켜고 끄기)와 터치 모드(누르면 켜지고 떼면 꺼짐) 중에서 선택합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite fiksavimo režimą (palieskite, kad perjungtumėte) arba lietimo režimą (paspauskite įjungti, atleiskite)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlieties starp fiksācijas režīmu (pieskarieties, lai pārslēgtu) vai pieskāriena režīmu (nospiediet ieslēgtu, atlaidiet izslēgtu)."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете помеѓу режимот на заклучување (допрете за да префрлите) или режим на допир (притиснете го, отпуштете го)."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түгжээ горим (унтраахын тулд товш) эсвэл мэдрэгчтэй горим (асаах, суллах) хоёрын аль нэгийг нь сонгоно уу."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih antara mod Latch (ketik untuk hidup/mati) atau mod Sentuh (tekan untuk hidup, lepas untuk mati)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg mellom Latch-modus (trykk for å slå på/av) eller Touch-modus (hold nede for å slå på, slipp for å slå av)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies tussen Latch-modus (tik om aan/uit te zetten) of Touch-modus (ingedrukt houden om aan te zetten, loslaten om uit te zetten)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz między trybem „Latch” (dotknij, aby włączyć/wyłączyć) a trybem „Touch” (przytrzymaj, aby włączyć, puść, aby wyłączyć)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha entre o modo Trava (toque para ligar/desligar) ou o modo Toque (pressione para ligar, solte para desligar)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe entre o modo Latch (tocar para ligar/desligar) ou o modo Toque (manter pressionado para ligar, soltar para desligar)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege între modul Latch (atinge pentru a porni/opri) sau modul Touch (ține apăsat pentru a porni, eliberează pentru a opri)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите режим «Latch» (нажать для переключения) или «Touch» (нажать — включить, отпустить — выключить)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte medzi režimom Latch (klepnutím zapnúť/vypnúť) alebo režimom Touch (podržaním zapnúť, uvoľnením vypnúť)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite med načinom Latch (tapnite za vklop/izklop) ali načinom Touch (pritisnite za vklop, spustite za izklop)."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgjidhni midis modalitetit të mbylljes (trokitni për ta ndryshuar) ose modalitetit të prekjes (shtypni, lëshojeni)."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Изаберите између Латцх режима (тапните за пребацивање) или Тоуцх режима (притисните, отпустите)."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Изаберите између Латцх режима (тапните за пребацивање) или Тоуцх режима (притисните, отпустите)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj mellan Latch-läge (tryck för att slå på/av) eller Touch-läge (håll nere för att tända, släpp för att släcka)."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua kati ya modi ya Latch (gonga ili kugeuza) au Modi ya Kugusa (bonyeza, toa mbali)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "லாட்ச் பயன்முறையில் (மாறுவதற்கு தட்டவும்) அல்லது டச் பயன்முறை (ஆன், ரிலீஸ் ஆஃப்) ஆகியவற்றிற்கு இடையே தேர்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లాచ్ మోడ్ (టోగుల్ చేయడానికి నొక్కండి) లేదా టచ్ మోడ్ (ఆన్, రిలీజ్ ఆఫ్) మధ్య ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกระหว่างโหมด Latch (แตะเพื่อเปิด/ปิด) หรือโหมด Touch (กดค้างเพื่อเปิด ปล่อยเพื่อปิด)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Latch mod (dokunarak aç/kapa) veya Touch mod (basılı tutunca açılır, bırakınca kapanır) arasında seçim yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть між режимом Latch (натиснути для вмикання/вимикання) або режимом Touch (натиснути й тримати, відпустити щоб вимкнути)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لیچ موڈ (ٹوگل کرنے کے لیے تھپتھپائیں) یا ٹچ موڈ (پر دبائیں، ریلیز آف) کے درمیان انتخاب کریں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mandal rejimi (oʻtish uchun teging) yoki Sensor rejimi (yoqish, oʻchirish) oʻrtasidan tanlang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn giữa chế độ Latch (chạm để bật/tắt) hoặc chế độ Touch (nhấn để bật, nhả để tắt)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁定模式（点击以切换）或触摸模式（按住即开，松开即关）之间进行选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「鎖定模式」（點擊切換）或「觸控模式」（按住開啟，鬆開關閉）。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「鎖定」模式（點擊即開/關）或「按住」模式（按住開、鬆手關）。"
          }
        }
      }
    },
