    "A warm and gentle almond theme.": {
      "comment": "The name of a color model that uses a gentle and calming almond color as a base for other colors",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سمة لوزية دافئة ولطيفة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tema d’ametlla càlid i suau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemné a teplé mandlové téma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lunt og blidt mandeltema."
          }
        },
