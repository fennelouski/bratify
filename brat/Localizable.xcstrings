    "TorchHelp": {
      "comment": "Explain what happens when the user touches the flashlight button/toggle",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel die toestel se flitslig wanneer Torch Touch aan is."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم بالتبديل بين تشغيل وإطفاء مصباح الجهاز عند تشغيل Torch Touch."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пераключыць ліхтарык прылады, калі ўключаны Torch Touch."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Превключете фенерчето на устройството, когато Torch Touch е включен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টর্চ টাচ চালু থাকলে ডিভাইসের ফ্ল্যাশলাইট টগল করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva la llanterna del dispositiu quan Torch Touch està activat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zap/vyp svítilnu zařízení, když je Zapnutí dotykem zapnuté."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle flashlight y ddyfais pan fydd Torch Touch ymlaen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænd/sluk lommelygten, når Berøringslys er tændt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die Taschenlampe bei Fackel‑Berührung ein oder aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποίηση/απενεργοποίηση φακού όταν το Torch Touch είναι ενεργό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle the device flashlight when Torch Touch is on."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle the device’s torch when Torch Touch is on."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle the device flashlight when Torch Touch is on."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle the device’s torch when Torch Touch is on."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle the device’s torch when Torch Touch is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna la linterna del dispositivo cuando está encendida"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva la linterna cuando Toque linterna está activado."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva la linterna cuando Toque linterna está activado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülitage seadme taskulamp sisse, kui Torch Touch on sisse lülitatud."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aldatu gailuaren linterna Torch Touch aktibatuta dagoenean."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی Torch Touch روشن است، چراغ قوه دستگاه را روشن کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda laitteen taskulamppua, kun Kosketuslamppu on päällä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-toggle ang flashlight ng device kapag naka-on ang Torch Touch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculer la lampe torche de l’appareil lorsqu’elle est allumée"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive la lampe de poche lorsque Touche torche est activée."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoránaigh splancsolas an ghléis nuair atá Tóirse Touch ar siúl."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a lanterna do dispositivo cando o Torch Touch estea activado."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעיל או מכבה את הפנס כש־Torch Touch פעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Torch Touch चालू होने पर फ़्लैशलाइट टॉगल करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključuje ili isključuje svjetiljku uređaja kad je Torch Touch uključen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolja vagy kikapcsolja a készülék zseblámpáját, amikor a Torch Touch be van kapcsolva."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միացնել սարքի լապտերը, երբ Torch Touch-ը միացված է:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengaktifkan atau menonaktifkan senter perangkat saat Torch Touch aktif."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skiptu um vasaljós tækisins þegar kveikt er á Torch Touch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva la torcia del dispositivo quando Torch Touch è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Torch Touchがオンのとき、デバイスのフラッシュライトを切り替えます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩართეთ მოწყობილობის ფანარი, როდესაც Torch Touch ჩართულია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Torch Touch қосулы кезде құрылғы шамын ауыстырып-қосқыш."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Torch Touch가 켜져 있을 때 기기의 플래시를 켜거나 끕니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perjunkite įrenginio žibintuvėlį, kai įjungtas „Torch Touch“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārslēdziet ierīces lukturīti, kad ir ieslēgts Torch Touch."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вклучете ја фенерчето на уредот кога е вклучен Torch Touch."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Torch Touch асаалттай үед төхөөрөмжийн гар чийдэнг асаана уу."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghidupkan atau mematikan lampu suluh peranti apabila Torch Touch dihidupkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår enhetens lommelykt av og på når Torch Touch er aktivert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel de zaklamp van het apparaat in of uit wanneer Torch Touch is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełącza latarkę urządzenia, gdy Torch Touch jest włączony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa ou desativa a lanterna do dispositivo quando o Torch Touch está ligado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa ou desativa a lanterna do dispositivo quando o Torch Touch está ligado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează sau dezactivează lanterna dispozitivului când Torch Touch este activat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включённом Torch Touch включает или выключает фонарик устройства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepína baterku zariadenia, keď je Torch Touch zapnutý."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopi ali izklopi svetilko naprave, ko je Torch Touch vklopljen."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ndryshoni elektrik dore të pajisjes kur Torch Touch është i ndezur."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Укључите лампу уређаја када је Торцх Тоуцх укључен."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Укључите лампу уређаја када је Торцх Тоуцх укључен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiverar eller inaktiverar enhetens ficklampa när Torch Touch är aktiverat."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Geuza tochi ya kifaa wakati Tochi Touch imewashwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டார்ச் டச் இயக்கத்தில் இருக்கும் போது சாதன ஒளிரும் விளக்கை நிலைமாற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టార్చ్ టచ్ ఆన్‌లో ఉన్నప్పుడు పరికరం ఫ్లాష్‌లైట్‌ని టోగుల్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด/ปิดไฟฉายของอุปกรณ์เมื่อ Torch Touch เปิดใช้งานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Torch Touch açıkken cihazın el fenerini açıp kapatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнути або вимкнути ліхтарик пристрою, коли Torch Touch увімкнено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹارچ ٹچ آن ہونے پر ڈیوائس کی فلیش لائٹ کو ٹوگل کریں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Torch Touch yoqilganda qurilma chirog‘ini yoqing."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật/tắt đèn pin của thiết bị khi Torch Touch đang bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
