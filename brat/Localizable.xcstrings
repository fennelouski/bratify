    "Clears filter looks and resets background zoom, flip, blur, and transparency": {
      "comment": "Accessibility hint for None filter preset\nELI5 explanation when user selects None filter preset",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwyder filterstyle en herstel agtergrondzoem, -spieëling, -waas en deurskynendheid"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسح مظاهر المرشح ويعيد تعيين تكبير الخلفية والتقليب والضبابية والشفافية"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ачышчае стылі фільтраў і скідвае маштаб, адлюстраванне, размытасць і празрыстасць фону"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изчиства изгледите на филтъра и нулира мащаба, флипа, размиването и прозрачността на фона"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিল্টার লুক মুছে দেয় এবং পটভূমির জুম, ফ্লিপ, ব্লার এবং স্বচ্ছতা রিসেট করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Esborra els aspectes de filtre i restableix el zoom, gir, desenfocament i transparència del fons"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymaže filtry a obnoví zoom, překlop, rozostření a průhlednost pozadí"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
