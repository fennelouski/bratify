    "BackgroundHelp": {
      "comment": "Explain what happens when the user touches the background button/toggle",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُغيِّر لون الخلفية بين الداكن والفاتح عند تشغيل Torch Touch."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvia el color de fons entre fosc i clar quan Torch Touch està activat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při zapnutém Torch Touch přepíná barvu pozadí mezi tmavou a světlou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift baggrundsfarven mellem mørk og lys, når Torch Touch er tændt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt die Hintergrundfarbe zwischen dunkel und hell, wenn die Taschenlampe an ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάζει το χρώμα φόντου μεταξύ σκοτεινού και φωτεινού όταν το Torch Touch είναι ενεργοποιημένο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the background color between dark and light when Torch Touch is on."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the background colour between dark and light when Torch Touch is on."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the background colour between dark and light when Torch Touch is on."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the background colour between dark and light when Torch Touch is on."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the background colour between dark and light when Torch Touch is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el color de fondo entre oscuro y claro cuando la linterna está encendida"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el color de fondo entre oscuro y claro cuando Torch Touch está encendido."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el color de fondo entre oscuro y claro cuando Torch Touch está encendido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda taustaväri tumman ja vaalean välillä, kun Torch Touch on päällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculer la couleur de l’arrière-plan entre sombre et clair lorsque la lampe est allumée"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterner la couleur d’arrière-plan entre foncé et clair lorsque Torch Touch est activé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחליף את צבע הרקע בין כהה לבהיר כאשר Torch Touch פעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब Torch Touch चालू हो, तब पृष्ठभूमि का रंग अंधेरे और रोशनी के बीच बदलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada je Torch Touch uključen, mijenja pozadinsku boju između tamne i svijetle."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja a háttérszínt sötét és világos között, amikor a Torch Touch be van kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengganti warna latar belakang antara gelap dan terang saat Torch Touch aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia il colore di sfondo tra scuro e chiaro quando Torch Touch è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Torch Touchがオンのとき、背景色をダークとライトの間で切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Torch Touch가 켜져 있을 때 배경색을 어두운 색과 밝은 색으로 전환합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar warna latar belakang antara gelap dan cerah apabila Torch Touch dihidupkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt bakgrunnsfarge mellom mørk og lys når Torch Touch er påslått."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel de achtergrondkleur tussen donker en licht wanneer Torch Touch ingeschakeld is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia kolor tła między ciemnym a jasnym, gdy Torch Touch jest włączony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera a cor de fundo entre escuro e claro quando o Torch Touch está ligado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera a cor de fundo entre escuro e claro quando o Torch Touch está ligado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când Torch Touch este activat, schimbă culoarea de fundal între închis și deschis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включённом Torch Touch переключает цвет фона между тёмным и светлым."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri zapnutom Torch Touch prepína farbu pozadia medzi tmavou a svetlou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je Torch Touch vklopljen, preklopi barvo ozadja med temno in svetlo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växlar bakgrundsfärg mellan mörk och ljus när Torch Touch är aktiverat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับสีพื้นหลังระหว่างโทนเข้มและโทนอ่อนเมื่อ Torch Touch เปิดใช้งานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Torch Touch açıkken arka plan rengini koyu ve açık arasında değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час увімкненого Torch Touch перемикає колір фону між темним і світлим."
          }
        },
        "vi": {
