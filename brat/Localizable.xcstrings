    "This will permanently delete undo history for all designs. Your designs are not affected.": {
      "comment": "Alert message for removing all undo history",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit sal ongedaanmaakgeskiedenis vir alle ontwerpe permanent uitvee. Jou ontwerpe word nie geraak nie."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта назаўсёды выдаліць гісторыю адмен для ўсіх дызайнаў. Вашы дызайны не закрануты."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ще изтрие завинаги историята на отмените за всички дизайни. Вашите дизайни не са засегнати."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি স্থায়ীভাবে সমস্ত ডিজাইনের পূর্বাবস্থার ইতিহাস মুছে ফেলবে৷ আপনার ডিজাইন প্রভাবিত হয় না."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això suprimirà permanentment l'historial de desfers de tots els dissenys. Els vostres dissenys no es veuen afectats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím trvale odstraníte historii vrácení všech návrhů. Vaše návrhy nejsou ovlivněny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil permanent slette fortryd-historikken for alle designs. Dine designs påvirkes ikke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα διαγράψει οριστικά το ιστορικό αναίρεσης για όλα τα σχέδια. Τα σχέδιά σας δεν επηρεάζονται."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete undo history for all designs. Your designs are not affected."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete undo history for all designs. Your designs are not affected."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete undo history for all designs. Your designs are not affected."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete undo history for all designs. Your designs are not affected."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete undo history for all designs. Your designs are not affected."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente el historial de deshacer de todos los diseños. Tus diseños no se ven afectados."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente el historial de deshacer de todos los diseños. Tus diseños no se ven afectados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See kustutab jäädavalt kõigi kujunduste tagasivõtmiste ajaloo. Teie kujundust see ei mõjuta."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Horrela, betiko ezabatuko da diseinu guztien deseginen historia. Zure diseinuak ez dira eragiten."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با این کار تاریخچه لغو برای همه طرح‌ها برای همیشه حذف می‌شود. طرح های شما تحت تأثیر قرار نمی گیرند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa pysyvästi kaikkien mallien peruutushistorian. Tämä ei vaikuta suunnitelmiisi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanente nitong tatanggalin ang kasaysayan ng pag-undo para sa lahat ng mga disenyo. Hindi apektado ang iyong mga disenyo."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto eliminará permanentemente o historial de desfacer de todos os deseños. Os teus deseños non se ven afectados."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo će trajno izbrisati povijest poništavanja za sve dizajne. To ne utječe na vaše dizajne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel véglegesen törli az összes terv visszavonási előzményeit. Az Ön terveit ez nem érinti."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա ընդմիշտ կջնջի բոլոր նմուշների հետարկման պատմությունը: Ձեր դիզայնը չի ազդում:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus riwayat pembatalan semua desain secara permanen. Desain Anda tidak terpengaruh."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta mun varanlega eyða afturkallaferli fyrir alla hönnun. Hönnun þín hefur ekki áhrif."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს სამუდამოდ წაშლის გაუქმების ისტორიას ყველა დიზაინისთვის. თქვენი დიზაინი არ იმოქმედებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл барлық дизайн үшін қайтару тарихын біржола жояды. Сіздің дизайныңызға әсер етпейді."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai visam laikui ištrins visų dizainų anuliavimo istoriją. Jūsų dizainas neturi įtakos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tādējādi tiks neatgriezeniski dzēsta visu dizainu atsaukšanas vēsture. Jūsu dizaini netiek ietekmēti."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова трајно ќе ја избрише историјата на отповикување за сите дизајни. Вашите дизајни не се засегнати."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ нь бүх дизайны буцаах түүхийг бүрмөсөн устгах болно. Таны загварт нөлөөлөхгүй."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan memadamkan sejarah buat asal secara kekal untuk semua reka bentuk. Reka bentuk anda tidak terjejas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil permanent slette angreloggen for alle design. Designene dine påvirkes ikke."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta va șterge definitiv istoricul anulărilor pentru toate modelele. Desenele dvs. nu sunt afectate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto natrvalo odstránite históriu vrátenia všetkých návrhov. Vaše návrhy nie sú ovplyvnené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem boste trajno izbrisali zgodovino razveljavitev za vse dizajne. To ne vpliva na vaše dizajne."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo do të fshijë përgjithmonë historikun e zhbërjes për të gjitha dizajnet. Modelet tuaja nuk preken."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ово ће трајно избрисати историју опозива за све дизајне. Ваши дизајни нису погођени."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete undo history for all designs. Miundo yako haijaathirika."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது அனைத்து வடிவமைப்புகளுக்கான வரலாற்றை செயல்தவிர்க்க நிரந்தரமாக நீக்கும். உங்கள் வடிவமைப்புகள் பாதிக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది అన్ని డిజైన్‌ల కోసం అన్‌డూ హిస్టరీని శాశ్వతంగా తొలగిస్తుంది. మీ డిజైన్‌లు ప్రభావితం కావు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบประวัติการเลิกทำสำหรับการออกแบบทั้งหมดอย่างถาวร การออกแบบของคุณไม่ได้รับผลกระทบ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ تمام ڈیزائنز کے لیے انڈو ہسٹری کو مستقل طور پر حذف کر دے گا۔ آپ کے ڈیزائن متاثر نہیں ہوتے ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu barcha dizaynlar uchun bekor qilish tarixini butunlay oʻchirib tashlaydi. Sizning dizaynlaringiz ta'sir qilmaydi."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久刪除所有設計的撤銷歷史記錄。您的設計不受影響。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久刪除所有設計的撤銷歷史記錄。您的設計不受影響。"
          }
        }
      }
    },
