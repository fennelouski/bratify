    "BrightnessHelp": {
      "comment": "Explain what happens when the user touches the screen brightness button/toggle",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيد سطوع الشاشة إلى الحد الأقصى عند تشغيل Torch Touch."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmenta la brillantor de la pantalla al màxim quan Torch Touch està activat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvýší jas obrazovky na maximum, když je Torch Touch zapnutý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øger skærmens lysstyrke til maks, når Torch Touch er tændt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöht die Bildschirmhelligkeit auf das Maximum, wenn die Taschenlampe an ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυξάνει τη φωτεινότητα της οθόνης στο μέγιστο όταν το Torch Touch είναι ενεργό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase screen brightness to maximum when Torch Touch is on."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase screen brightness to maximum when Torch Touch is on."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase screen brightness to maximum when Torch Touch is on."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase screen brightness to maximum when Torch Touch is on."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase screen brightness to maximum when Torch Touch is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta el brillo de la pantalla al máximo cuando la linterna está encendida"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta el brillo de la pantalla al máximo cuando Torch Touch está encendido."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta el brillo de la pantalla al máximo cuando Torch Touch está encendido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää näytön kirkkautta maksimiin, kun Torch Touch on päällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmenter la luminosité de l’écran au maximum lorsque la lampe est allumée"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmenter la luminosité de l’écran au maximum lorsque Torch Touch est activé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעלה את בהירות המסך למקסימום כאשר Torch Touch פעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब Torch Touch चालू हो, तब स्क्रीन की ब्राइटनेस को अधिकतम कर दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povećava svjetlinu zaslona na maksimum kada je Torch Touch uključen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Növeli a képernyő fényerejét a maximumra, ha a Torch Touch be van kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meningkatkan kecerahan layar ke tingkat maksimum saat Torch Touch aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta la luminosità dello schermo al massimo quando Torch Touch è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Torch Touchがオンのとき、画面の明るさを最大にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Torch Touch가 켜져 있을 때 화면 밝기를 최대치로 설정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingkatkan kecerahan skrin kepada tahap maksimum apabila Torch Touch dihidupkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øker skjermens lysstyrke til maks når Torch Touch er påslått."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhoogt de schermhelderheid tot het maximum wanneer Torch Touch is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwiększa jasność ekranu do maksimum, gdy Torch Touch jest włączony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta o brilho da tela ao máximo quando o Torch Touch está ligado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta o brilho do ecrã para o máximo quando o Torch Touch está ligado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Crește luminozitatea ecranului la maximum atunci când Torch Touch este activat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включённом Torch Touch увеличивает яркость экрана до максимума."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvyšuje jas obrazovky na maximum pri zapnutom Torch Touch."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poveča svetlost zaslona na največ, ko je Torch Touch vklopljen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ökar skärmens ljusstyrka till max när Torch Touch är aktiverat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มความสว่างของหน้าจอเป็นระดับสูงสุดเมื่อ Torch Touch เปิดใช้งานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Torch Touch açıkken ekran parlaklığını maksimuma çıkarır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збільшує яскравість екрана до максимуму, коли Torch Touch увімкнено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tăng độ sáng màn hình lên mức tối đa khi Torch Touch đang bật."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Torch Touch 開啟時，將螢幕亮度調到最高。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
