    "BrightnessHelp": {
      "comment": "Explain what happens when the user touches the screen brightness button/toggle",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيد سطوع الشاشة إلى الحد الأقصى عند تشغيل Torch Touch."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Puja la lluminositat de la pantalla al màxim quan Torch Touch està activat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při Zapnutí dotykem zvýší jas displeje na maximum."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øger skærmens lysstyrke til maksimum, når Berøringslys er tændt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöht die Bildschirmhelligkeit bei Fackel‑Berührung auf das Maximum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυξάνει τη φωτεινότητα οθόνης στο μέγιστο όταν το Torch Touch είναι ενεργό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase screen brightness to maximum when Torch Touch is on."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase screen brightness to maximum when Torch Touch is on."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase screen brightness to maximum when Torch Touch is on."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase screen brightness to maximum when Torch Touch is on."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase screen brightness to maximum when Torch Touch is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta el brillo de la pantalla al máximo cuando la linterna está encendida"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
