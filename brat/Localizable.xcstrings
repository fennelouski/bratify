    "BrightnessHelp": {
      "comment": "Explain what happens when the user touches the screen brightness button/toggle",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhoog die helderheid van die skerm tot die maksimum wanneer Torch Touch aan is."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيد سطوع الشاشة إلى الحد الأقصى عند تشغيل Torch Touch."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Павялічце яркасць экрана да максімуму, калі ўключаны Torch Touch."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличете яркостта на екрана до максимум, когато Torch Touch е включен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টর্চ টাচ চালু থাকলে স্ক্রীনের উজ্জ্বলতা সর্বোচ্চ পর্যন্ত বাড়ান।"
          }
        },
        "ca": {
